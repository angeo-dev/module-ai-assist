<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Angeo_AiAssist::css/panel.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Angeo\AiAssist\Block\Adminhtml\Panel" name="angeo.ai.assist.panel" after="-">
                <arguments>
                    <argument name="source" xsi:type="string">agent_activity</argument>
                    <argument name="ref_params" xsi:type="string">period,from,to,store</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
